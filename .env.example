# Copy to .env. Replace the JWT placeholder before starting the API. Never commit .env.
DATABASE_URL=postgresql://aegis:aegis_local_only@localhost:5432/aegistrust
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Local-only defaults: 127.0.0.1. Set a host-provided interface such as 0.0.0.0 only when deploying.
BIND_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# For production, specify the extension origin explicitly, e.g. chrome-extension://<extension-id>.
EXTENSION_ORIGINS=
RECON_PORT=4101
SANDBOX_PORT=4102
RECON_WORKER_URL=http://localhost:4101
SANDBOX_WORKER_URL=http://localhost:4102
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_AEGIS_API_URL=http://localhost:4000
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CACHE_CLEAN_SECONDS=900
