{
  "manifest_version": 3,
  "name": "AegisTrust Link Guard",
  "version": "0.1.0",
  "description": "Blocks domains confirmed as phishing by your AegisTrust threat feed.",
  "permissions": ["declarativeNetRequest", "storage", "tabs"],
  "host_permissions": ["http://localhost:4000/*", "https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "AegisTrust status", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["src/content/blockScreen.js"], "run_at": "document_start" }]
}
